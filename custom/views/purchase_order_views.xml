<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_vitrage" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.vitrage</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="x_studio_projet_du_so" string="Projet du SO"/>
                <field name="x_studio_rfrence" string="Référence"/>
                <field name="x_is_glazing_order" invisible="1"/>
                <field name="x_studio_remise_1" string="Remise"/>
                <field name="x_studio_commentaire_livraison_vitrage_"/>
                <field name="x_studio_commentaire_interne_"/>
            </xpath>

            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="widget">fma_product_and_description_o2m</attribute>
            </xpath>

            <!--
                TOUTES les colonnes vitrage sont posees AVANT le produit, dans
                un seul xpath.

                Elles etaient auparavant reparties sur deux xpath visant la meme
                ancre, l'un « before » l'autre « after ». Seul le premier
                prenait effet : le Repere s'affichait, hauteur, largeur, spacer
                et forme jamais — absentes de la liste comme du selecteur de
                colonnes, donc absentes de l'arbre lui-meme. Une vue Studio
                remanie vraisemblablement la liste apres product_id.

                Plutot que de chercher laquelle, on pose tout du cote qui
                fonctionne. Le repere en tete reste la lecture voulue : c'est lui
                qui identifie la ligne sur le chantier, le produit vient ensuite.
            -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="x_fma_repere" string="Repère"
                       column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_hauteur" string="Hauteur"
                       column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_largeur" string="Largeur"
                       column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_spacer_2" string="Spacer"
                       column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_forme" string="Forme"
                       column_invisible="not parent.x_is_glazing_order"/>
                <!--
                    x_studio_posit est conserve, masque : une vue Studio s'y
                    accroche, et son retrait a rendu toute commande d'achat
                    impossible a ouvrir.
                -->
                <field name="x_studio_posit" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
