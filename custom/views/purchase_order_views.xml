<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_vitrage" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.vitrage</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="x_studio_projet_du_so" string="Projet du SO"/>
                <field name="x_studio_rfrence" string="Référence"/>
                <field name="x_is_glazing_order" invisible="1"/>
                <field name="x_studio_remise_1" string="Remise"/>
                <field name="x_studio_commentaire_livraison_vitrage_"/>
                <field name="x_studio_commentaire_interne_"/>
            </xpath>

            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="widget">fma_product_and_description_o2m</attribute>
            </xpath>

            <!-- Le repere se lit AVANT le produit : c'est lui qui identifie la
                 ligne sur le chantier, le produit vient ensuite. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="x_fma_repere" string="Repère" column_invisible="not parent.x_is_glazing_order"/>
                <!--
                    x_studio_posit est CONSERVE dans la liste, masque.

                    Une vue Studio s'y accroche :
                        //field[@name='order_line']/list//field[@name='x_studio_posit']

                    Le retirer a rendu toute commande d'achat impossible a
                    ouvrir — « L'element ne peut etre localise dans la vue
                    parente ». Un champ pose par Studio n'est pas seulement une
                    donnee affichee : c'est aussi un point d'ancrage pour
                    d'autres personnalisations, invisibles depuis le code.

                    Il reste donc dans l'arbre, sans occuper de colonne. Il
                    pourra disparaitre une fois la vue Studio reprise.
                -->
                <field name="x_studio_posit" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <!--
                    optional="show" est explicite a dessein. Ces quatre champs
                    existent deja dans la liste, poses par une vue Studio. Odoo
                    fusionne les declarations d'un meme champ : les miennes
                    heritaient donc de l'etat de la sienne, colonne optionnelle
                    masquee — d'ou un Repere visible, qui lui est nouveau, et
                    quatre colonnes absentes. En posant l'attribut, c'est la
                    derniere vue chargee qui tranche.
                -->
                <field name="x_studio_hauteur" string="Hauteur"
                       optional="show" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_largeur" string="Largeur"
                       optional="show" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_spacer_2" string="Spacer"
                       optional="show" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_forme" string="Forme"
                       optional="show" column_invisible="not parent.x_is_glazing_order"/>
            </xpath>
        </field>
    </record>
</odoo>
