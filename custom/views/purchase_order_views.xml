<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_vitrage" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.vitrage</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="x_studio_projet_du_so" string="Projet du SO"/>
                <field name="x_studio_rfrence" string="Référence"/>
                <field name="x_is_glazing_order" invisible="1"/>
                <field name="x_studio_remise_1" string="Remise"/>
                <field name="x_studio_commentaire_livraison_vitrage_"/>
                <field name="x_studio_commentaire_interne_"/>
            </xpath>

            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="widget">fma_product_and_description_o2m</attribute>
            </xpath>

            <!--
                Colonnes vitrage : structure reprise a l'identique de PreProd,
                ou elles s'affichent. Le modele Python est le meme sur les deux
                environnements ; seule cette vue differait. Les tentatives de
                correction en prod (les cinq champs regroupes avant product_id,
                sans condition) ne donnaient rien alors que la disposition de
                PreProd fonctionne : repere avant product_id, les quatre
                colonnes vitrage apres, chacune conditionnee a la commande.

                Ne pas regrouper ces champs dans un seul xpath : le widget
                fma_product_and_description_o2m traite la colonne produit a
                part, et c'est la seule difference restante entre les deux
                environnements.
            -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="x_fma_repere" string="Repère" column_invisible="not parent.x_is_glazing_order"/>
                <!--
                    x_studio_posit est conserve, masque : une vue Studio s'y
                    accroche, et son retrait a rendu toute commande d'achat
                    impossible a ouvrir.
                -->
                <field name="x_studio_posit" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="x_studio_hauteur" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_largeur" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_spacer_2" string="Spacer" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_forme" string="Forme" column_invisible="not parent.x_is_glazing_order"/>
            </xpath>
        </field>
    </record>
</odoo>
