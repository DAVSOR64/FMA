<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retour métier ELOGAU, réunion du 20/07/2026 :
         - remise, commentaires et dimensions vitrage : champs déjà déclarés
           en code mais absents de la fiche -> affichés, uniquement sur les
           commandes "vitrage" (catégorie produit "Remplissage").
         - "Contrat cadre" (requisition_id, module purchase_requisition) :
           confirmé inutile ("chez Emmanuel") -> masqué. -->
    <record id="view_purchase_order_form_inherit_vitrage" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.vitrage</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="x_is_glazing_order" invisible="1"/>
                <field name="x_studio_remise" invisible="not x_is_glazing_order"/>
                <field name="x_studio_remise_1" invisible="not x_is_glazing_order"/>
                <field name="x_studio_commentaire_livraison_vitrage_" invisible="not x_is_glazing_order"/>
                <field name="x_studio_commentaire_interne_" invisible="not x_is_glazing_order"/>
            </xpath>

            <xpath expr="//field[@name='requisition_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="x_studio_posit" string="Repère" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_hauteur" column_invisible="not parent.x_is_glazing_order"/>
                <field name="x_studio_largeur" column_invisible="not parent.x_is_glazing_order"/>
            </xpath>
        </field>
    </record>
</odoo>
