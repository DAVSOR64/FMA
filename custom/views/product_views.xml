<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Onglet "Vitrage" sur la fiche article (variante) : les champs
         existent déjà en code (custom/models/product.py, sur
         product.product sauf Hauteur/Largeur (mm) qui sont sur
         product.template et restent accessibles ici via la délégation
         product.product vers product.template) mais n'étaient exposés
         dans aucune vue. Couleur PB (Int/Ext) : deux champs candidats avec
         le même libellé existent en code (x_studio_couleur_pb_intext / _1)
         — seul le premier (x_studio_couleur_pb_intext) est consommé
         ailleurs (gabarit d'export
         purchase_order_export/data/purchase_order_export_template_v2.xml),
         c'est celui-là qui est exposé ici. -->
    <record id="view_product_product_form_inherit_vitrage" model="ir.ui.view">
        <field name="name">product.product.form.inherit.vitrage</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Champs de l'onglet "Informations générales" existant en code
                 mais jamais exposés dans une vue (cf. arch Studio d'origine,
                 vue ir_ui_view id 2755 en prod, relevé le 2026-07-30) :
                 Entrepôt juste après la Référence interne, le reste juste
                 après Société. Code tarifaire était ancré en prod sur un
                 bouton spécifique à cette base (non reproductible ici) ;
                 regroupé avec les autres champs Studio à la place. -->
            <field name="default_code" position="after">
                <field name="x_studio_entrept" string="Entrepôt"/>
            </field>
            <!-- Ces champs ont d'abord ete poses a la suite de company_id.
                 Deux defauts : hors de tout <group>, un champ est rendu nu,
                 sans etiquette quel que soit son attribut string ; et l'ancre
                 company_id se trouve en tete de formulaire, ce qui remontait
                 les blocs au-dessus meme du nom du produit. Ils sont donc
                 places en bas du premier onglet, dans des groupes titres. -->
            <xpath expr="//notebook/page[1]" position="inside">
                <group>
                    <group name="fma_logikal" string="Logikal">
                        <field name="x_studio_ref_int_logikal" string="Référence inter Logikal"/>
                        <field name="x_studio_color_logikal" string="Couleur Logikal"/>
                        <field name="x_studio_unit_logikal" string="Unité Logikal"/>
                    </group>
                    <group name="fma_references" string="Références et gestion">
                        <field name="x_studio_code_tarifaire" string="Code tarifaire"/>
                        <field name="x_studio_ref_diapason" string="Réf. Diapason"/>
                        <field name="x_studio_longueur_m" string="Longueur (m)"/>
                        <field name="x_studio_conso_laffaire" string="Consommation à l'affaire"/>
                        <field name="x_studio_cration_auto" string="Création auto"/>
                    </group>
                </group>
            </xpath>
            <notebook position="inside">
                <page string="Vitrage">
                    <group>
                        <group>
                            <field name="x_studio_position"/>
                            <field name="x_studio_hauteur_mm"/>
                            <field name="x_studio_largeur_mm"/>
                            <field name="x_studio_spacer"/>
                            <field name="x_studio_type"/>
                        </group>
                        <group>
                            <field name="x_studio_type_pb"/>
                            <field name="x_studio_couleur_pb_intext"/>
                            <field name="x_studio_nbr_pb_vertical"/>
                            <field name="x_studio_nbr_pb_horizontal"/>
                            <field name="x_studio_position_en_x_pb_horizontal_1"/>
                            <field name="x_studio_position_en_y_pb_horizontal_1"/>
                            <field name="x_studio_position_en_x_pb_vertical_1"/>
                            <field name="x_studio_position_en_y_pb_vertical_1"/>
                            <field name="x_studio_longueur_pb_horizontal_1"/>
                            <field name="x_studio_longueur_pb_vertical"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    <record id="view_product_variant_easy_edit_inherit_studio" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.inherit.studio</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <group name="fma_references" string="Références">
                        <field name="x_studio_code_tarifaire" string="Code tarifaire"/>
                        <field name="x_studio_ref_diapason" string="Réf. Diapason"/>
                        <field name="x_studio_ref_int_logikal" string="Référence inter Logikal"/>
                        <field name="x_studio_color_logikal" string="Couleur Logikal"/>
                        <field name="x_studio_unit_logikal" string="Unité Logikal"/>
                    </group>
                    <group name="fma_gestion" string="Gestion">
                        <field name="x_studio_conso_laffaire"/>
                        <field name="x_studio_cration_auto"/>
                    </group>
                    <!-- Vitrage : la page existait sur le formulaire variante
                         COMPLET, mais un achat ouvre la fiche « edition
                         rapide » — d'ou des informations vitrage visibles
                         depuis l'inventaire et absentes depuis l'achat. Memes
                         champs, meme ordre. -->
                    <group name="fma_vitrage" string="Vitrage">
                        <field name="x_studio_position" string="Position"/>
                        <field name="x_studio_hauteur_mm" string="Hauteur (mm)"/>
                        <field name="x_studio_largeur_mm" string="Largeur (mm)"/>
                        <field name="x_studio_spacer" string="Spacer"/>
                        <field name="x_studio_type" string="Type"/>
                    </group>
                    <group name="fma_vitrage_pb" string="Petits bois">
                        <field name="x_studio_type_pb" string="Type PB"/>
                        <field name="x_studio_couleur_pb_intext" string="Couleur PB (Int/Ext)"/>
                        <field name="x_studio_nbr_pb_vertical" string="Nbr PB vertical"/>
                        <field name="x_studio_nbr_pb_horizontal" string="Nbr PB horizontal"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
