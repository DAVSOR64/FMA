<odoo>
    <record id="view_order_form_custom" model="ir.ui.view">
        <field name="name">sale.order.form.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- §3B du handoff : frise graphique, sous le titre et avant les
                 groupes. C'est un composant OWL, pas un groupe de champs :
                 il ne declare rien dans l'arch, ses dependances sont portees
                 par le widget lui-meme.

                 Les dates restent dans l'onglet Chronologie, qui en est la
                 source de verite. C'est important au-dela de l'ergonomie :
                 les vues Studio s'accrochent a so_date_devis_valide, elles
                 l'y retrouvent. Retirer ce champ de l'arch les casserait. -->
            <xpath expr="//group[@name='sale_header']" position="before">
                <widget name="fma_timeline"/>
            </xpath>

            <!-- Informations principales/supplémentaires restent une nouvelle
                 ligne pleine largeur de la grille de sale_header (confirmé bien
                 placées par le métier le 20/07). -->
            <xpath expr="//group[@name='sale_header']" position="inside">
                <group string="Informations principales">
                    <field name="so_commande_client"/>
                    <field name="so_delai_confirme_en_semaine"/>
                    <field name="main_contact_id"
                           string="Contact principal"
                           domain="[('parent_id', '=', partner_id)]"
                           context="{'default_parent_id': partner_id}"/>
                </group>

                <!-- « Informations supplementaires » a disparu de l'entete :
                     ses champs sont dans l'onglet Livraison & acces (§5). -->
            </xpath>

            <!-- Onglets en bas de la vue -->
            <xpath expr="//sheet/notebook" position="inside">

                <!-- §5 : acces chantier et expedition, sortis de l'entete.
                     float_time sur les horaires pour afficher 8:00 et non
                     0,00 (§6). -->
                <page string="Livraison &amp; accès" name="fma_livraison">
                    <group>
                        <group string="Accès chantier">
                            <field name="so_acces_bl"/>
                            <field name="so_type_camion_bl"/>
                            <field name="so_horaire_ouverture_bl" widget="float_time"/>
                            <field name="so_horaire_fermeture_bl" widget="float_time"/>
                        </group>
                        <group string="Expédition">
                            <field name="commitment_date"/>
                            <field name="so_date_de_livraison_prevu"/>
                            <field name="so_date_de_livraison" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- §5 : source de verite des dates. La frise du haut n'en est
                     que le reflet, en lecture seule. -->
                <page string="Chronologie" name="fma_chronologie_page">
                    <group>
                        <group string="Devis">
                            <field name="so_date_de_reception_devis"/>
                            <field name="so_date_du_devis"/>
                            <field name="so_date_de_modification_devis"/>
                            <field name="so_date_devis_valide"/>
                        </group>
                        <group string="Commande et production">
                            <field name="so_date_ARC"/>
                            <field name="so_date_bpe"/>
                            <field name="so_date_bon_pour_fab"/>
                            <field name="so_date_de_fin_de_production_reel"/>
                            <field name="so_statut_avancement_production"/>
                        </group>
                    </group>
                </page>

                <!-- Onglet Analyse Financière (déjà existant) -->
                <page string="Analyse Financière">
                    <group>
                        <group string="Chiffres Devis">
                            <field name="so_achat_matiere_devis"/>
                            <field name="so_achat_vitrage_devis"/>
                            <field name="so_cout_mod_devis"/>
                            <field name="so_mtt_facturer_devis"/>
                            <field name="so_marge_brute_devis"/>
                            <field name="so_prc_marge_brute_devis_display"/>
                            <field name="so_mcv_devis"/>
                            <field name="so_prc_mcv_devis_display"/>
                        </group>
                        <group string="Chiffres B.E.">
                            <field name="so_achat_matiere_be"/>
                            <field name="so_achat_vitrage_be"/>
                            <field name="so_cout_mod_be"/>
                            <field name="so_mtt_facturer_be"/>
                            <field name="so_marge_brute_be"/>
                            <field name="so_prc_marge_brute_be_display"/>
                            <field name="so_mcv_be"/>
                            <field name="so_prc_mcv_be_display"/>
                        </group>
                        <group string="Chiffres Réel">
                            <field name="so_achat_matiere_reel"/>
                            <field name="so_achat_vitrage_reel"/>
                            <field name="so_cout_mod_reel"/>
                            <field name="so_mtt_facturer_reel"/>
                            <field name="so_marge_brute_reel"/>
                            <field name="so_prc_marge_brute_reel_display"/>
                            <field name="so_mcv_reel"/>
                            <field name="so_prc_mcv_reel_display"/>
                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>

</odoo>
