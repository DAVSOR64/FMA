<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multiple numerique dans la liste des regles de reapprovisionnement.

         L'ancrage se fait sur replenishment_uom_id, la colonne « Multiple »
         native, pour que les deux notions se lisent cote a cote. Ce champ est
         pose en optional="hide" par le standard : notre colonne est en
         optional="show" puisque c'est elle que les acheteurs utilisent.

         view_warehouse_orderpoint_tree_editable_show_trigger herite de cette
         vue-ci : une seule extension suffit pour les deux. -->
    <record id="view_warehouse_orderpoint_tree_multiple" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.fma.multiple</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='replenishment_uom_id']" position="after">
                <field name="fma_qty_multiple" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
