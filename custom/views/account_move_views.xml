<odoo>
    <record id="view_move_form_custom" model="ir.ui.view">
        <field name="name">account.move.form.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group>
                    <field name="inv_mode_de_reglement"/>
                    <field name="inv_code_tiers"/>
                    <field name="inv_affacturage"/>
                    <field name="inv_commande_client"/>
                    <!-- Un seul « Commercial » a l'ecran, jamais deux. Meme
                         repli qu'a l'impression : les factures anterieures a
                         la bascule n'ont pas de commercial_id (migration
                         19.0.1.0.41) et leur PDF retombe sur inv_commercial.
                         La condition porte sur l'etat et non sur le seul
                         commercial_id : sur un brouillon, le champ doit rester
                         saisissable meme vide, sinon plus aucune facture
                         manuelle ne pourrait recevoir de commercial.
                         inv_commercial est un related vers le client : il suit
                         les changements de commercial de celui-ci. C'est ce
                         que le rapport imprimait deja avant la bascule, d'ou
                         l'absence d'ecart a la reimpression. -->
                    <field name="commercial_id"
                           string="Commercial"
                           invisible="not commercial_id and state == 'posted'"/>
                    <field name="inv_commercial"
                           string="Commercial"
                           readonly="1"
                           invisible="commercial_id or state != 'posted'"/>
                    <field name="inv_activite"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
