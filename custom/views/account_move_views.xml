<odoo>
    <record id="view_move_form_custom" model="ir.ui.view">
        <field name="name">account.move.form.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group>
                    <field name="commercial_id"/>
                    <field name="mode_reglement_id"/>
                    <!-- Masque, pas retire : le noeud reste dans l'arch pour
                         les vues Studio qui s'y accrochent. Le mode de reglement
                         se lit sur mode_reglement_id, qui affiche « code -
                         libelle » et qui est la meme donnee que sur le devis. -->
                    <field name="inv_mode_de_reglement" invisible="1"/>
                    <field name="inv_code_tiers"/>
                    <field name="inv_affacturage"/>
                    <field name="inv_commande_client"/>
                    <field name="inv_commercial"/>
                    <field name="inv_activite"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
