<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reorganisation de la fiche contact.

        Les champs metier etaient poses par des vues Studio, invisibles au code
        et perdues a la moindre regeneration, ou empiles dans l'onglet Ventes &
        Achats sans regroupement. Ils sont decrits ici, en trois endroits :
        l'identite legale sous le numero de TVA, un onglet Assurance-credit, un
        onglet Technique.

        CHAMPS VOLONTAIREMENT NON AFFICHES. Ils restent en base et dans les
        exports ; seule la saisie est allegee.

            part_siren, x_studio_char_field_G6qIE  anciens champs SIREN ; le
                                                   SIREN est company_registry
            part_mode_de_reglement                 remplace par le referentiel
                                                   x_reglements
            x_studio_compte                        compte comptable, technique
            x_studio_bic, x_studio_iban            doublons de part_bic/part_iban
            x_studio_affacturage,
            x_studio_allianz_*                     doublons des champs part_*
            x_studio_civilit                       remplace par part_civilite
            x_studio_mode_de_rglement              Char mort, jamais alimente

        ANCRAGES. Seuls des points des vues standard sont utilises : le champ
        company_registry que l10n_fr pose sous la TVA, celui du groupe misc, le
        notebook, et le groupe de l'onglet Ventes & Achats. Les noms de page
        natifs varient d'une version a l'autre ; s'y accrocher ferait echouer
        l'installation.

        AUTRES MODULES. Ces champs ne sont pas cites ici : les citer les
        rendrait obligatoires, alors que custom ne peut pas dependre de modules
        qui dependent deja de lui. Chacun s'accroche depuis son cote :

            purchase_order_export     -> groupe fma_flux_documentaires
            fma_customer_outstanding  -> apres part_decision, deja en place
            fma_iziqo_sync            -> onglet fma_technique_page, a faire
                                         par son auteur
    -->
    <record id="view_partner_form_custom" model="ir.ui.view">
        <field name="name">res.partner.form.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!--
                Identite legale, sous le numero de TVA.

                POURQUOI PAS « apres le champ vat ». base_vat (standard,
                priorite 15, donc avant cette vue) deplace le champ vat dans
                un <div name="vat_vies_container">. S'accrocher a vat posait
                donc tout ce bloc DANS ce div, hors de la grille du groupe :
                plus de libelle pour le SIREN ni la forme juridique, des
                libelles de cases a cocher passes au-dessus d'elles, et un
                trou a la place des champs vides. Le bloc s'accroche
                desormais a un enfant direct du groupe.

                LE SIREN EST LE CHAMP DEJA POSE PAR l10n_fr (standard,
                priorite 14) : company_registry, juste apres la TVA, libelle
                « Siret ». On le relibelle au lieu d'en poser un second —
                c'etait le numero affiche deux fois. C'est le seul
                company_registry du groupe du haut ; celui de l'onglet Ventes
                & Achats est masque plus bas. Il est affiche pour toutes les
                fiches, y compris sans pays renseigne.
            -->
            <xpath expr="//sheet/group//field[@name='company_registry']"
                   position="attributes">
                <attribute name="string">SIREN</attribute>
                <attribute name="placeholder">9 chiffres</attribute>
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//sheet/group//field[@name='company_registry']"
                   position="after">
                <field name="fma_siret" placeholder="14 chiffres"/>
                <field name="part_civilite" string="Forme juridique"/>
                <field name="x_studio_code_naf" string="Code NAF"/>
                <field name="x_studio_etablissement" string="Établissement"/>
                <!--
                    Le commercial FMA.

                    Il en avait ete retire au profit du seul vendeur natif ; le
                    metier le veut a l'ecran, et il n'est pas redondant : le
                    vendeur est un utilisateur Odoo, le commercial un EMPLOYE du
                    departement Commerce, sans licence. C'est lui que
                    sale.order.commercial_id recopie a la selection du client,
                    puis _prepare_invoice sur la facture, et c'est lui que
                    fma_iziqo_sync transmet a Iziqo.
                -->
                <field name="x_studio_commercial_1" string="Commercial"/>
                <!--
                    Enfants directs du groupe, ces deux cases recoivent leur
                    libelle a gauche comme les autres champs. Le montage
                    <label/> + <div> qui les entourait ne servait qu'a
                    compenser leur place dans le div de la TVA.
                -->
                <field name="x_studio_client_bloque" string="Client bloqué"/>
                <field name="x_studio_cgv_rib" string="CGV + RIB"/>
                <!--
                    part_siren est CONSERVE, masque.

                    L'ancienne version de cette vue le posait. Une vue Studio
                    peut donc s'y accrocher, et son retrait rendrait la fiche
                    impossible a ouvrir — c'est ce qui est arrive aux commandes
                    d'achat avec x_studio_posit : « L'element ne peut etre
                    localise dans la vue parente ».

                    Un champ pose par une vue n'est pas seulement une donnee
                    affichee : c'est aussi un point d'ancrage pour d'autres
                    personnalisations, invisibles depuis le code. On ne le
                    retire donc pas de l'arbre, on cesse seulement de
                    l'afficher. Il pourra disparaitre une fois les vues
                    Studio de res.partner reprises.
                -->
                <field name="part_siren" invisible="1"/>
            </xpath>
            <!-- Le SIREN n'est affiche qu'une fois, en haut. -->
            <!-- Le vendeur natif (user_id, un utilisateur Odoo) ne s'affiche
                 plus sur la fiche : chez FMA, c'est le « Commercial » qui
                 fait foi. Masque et non retire, pour que les vues qui
                 s'ancrent dessus continuent de se charger. -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='misc']/field[@name='company_registry']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Comptabilite et reglement, la ou l'onglet Ventes & Achats les
                 attend deja -->
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Comptabilité et règlement">
                    <!-- Le referentiel x_reglements est la source vivante :
                         c'est lui qu'alimente mode_reglement_id sur le devis et
                         la facture. -->
                    <field name="x_studio_mode_de_rglement_dsa" string="Mode de règlement"/>
                    <field name="fma_remise_alu"/>
                    <field name="fma_remise_acier"/>
                    <field name="part_code_tiers" string="Code tiers"/>
                    <field name="x_studio_gneration_n_compte_1"
                           string="Génération automatique du n° de compte"/>
                    <field name="part_bic" string="BIC"/>
                    <field name="part_iban" string="IBAN"/>
                    <field name="x_studio_adresse_dmat_facturation"
                           string="Adresse de facturation dématérialisée"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">

                <page name="fma_assurance_credit_page" string="Assurance-crédit">
                    <group>
                        <group string="Encours et conditions">
                            <field name="credit_limit"/>
                            <field name="x_studio_encours_autoris" string="Encours autorisé"/>
                            <field name="x_studio_mtt_echu" string="Montant échu"/>
                            <field name="x_studio_mtt_non_echu" string="Montant non échu"/>
                            <field name="x_studio_remise" string="Remise (%)"/>
                        </group>
                        <group string="Couverture">
                            <field name="part_affacturage" string="Affacturage"/>
                            <field name="part_couverture" string="ALLIANZ ND COVER"/>
                            <!-- La date n'a de sens que si la couverture existe. -->
                            <field name="part_date_couverture" string="Date de couverture"
                                   invisible="not part_couverture"/>
                            <field name="part_montant_couverture"
                                   string="Montant couvert"
                                   invisible="not part_couverture"/>
                            <field name="part_decision" string="Assurance-crédit"/>
                        </group>
                    </group>
                </page>

                <page name="fma_technique_page" string="Technique">
                    <group>
                        <group string="Identification externe" name="fma_identification_externe">
                            <field name="x_studio_code" string="Code" readonly="1"/>
                            <field name="x_studio_code_diap" string="Code Diapason"/>
                            <field name="x_studio_ref_logikal" string="Réf. LOGIKAL"/>
                            <field name="x_studio_compte_proginov" string="Compte PROGINOV"/>
                            <field name="x_studio_iziqo_1" string="Présent dans IziQo"/>
                        </group>
                        <!-- Rempli par purchase_order_export, qui depend de
                             custom et se charge donc apres. Laisser le groupe
                             ici garde la mise en page stable meme si ce module
                             venait a etre desinstalle. -->
                        <group string="Flux documentaires" name="fma_flux_documentaires"/>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
