<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x_studio_niveau_de_complexite reste declare et securise en Python
         (models/mrp_production.py). Son affichage est desormais porte par le
         bloc « Fabrication FMA » de fma_lot_fabrication, avec les autres
         champs metier de l'OF. L'enregistrement de vue a ete supprime : un
         arch reduit a un commentaire est refuse par Odoo. -->

    <!--
        Le projet de la vente, dans l'onglet Divers, aupres de la Source dont
        il est la traduction en affaire.

        Enregistrement dedie : cette branche n'a plus de vue d'OF dans custom,
        et le champ n'a pas sa place dans le bloc « Fabrication FMA » de
        fma_lot_fabrication, qui appartient a un autre module.

        Ancre sur origin plutot que sur la page : le champ existe a coup sur
        sur mrp.production, le nom de la page moins.
    -->
    <record id="view_mrp_production_form_projet_vente" model="ir.ui.view">
        <field name="name">mrp.production.form.projet.vente</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin'][not(ancestor::field)]" position="after">
                <field name="x_studio_projet_de_la_vente"/>
            </xpath>
        </field>
    </record>
</odoo>
