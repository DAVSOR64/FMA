<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- x_studio_niveau_de_complexite existe et est sécurisé en Python
         (models/mrp_production.py) depuis le portage Studio, mais n'était
         affiché dans aucune vue. -->
    <record id="view_mrp_production_form_inherit_complexite" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.niveau.complexite</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="x_studio_niveau_de_complexite" string="Niveau de complexité"/>
            </xpath>

            <!-- « Fin de fab » : la date forcee du macro planning, celle sur
                 laquelle l'ordonnanceur agit. Elle etait posee par Studio
                 au-dessus du numero d'OF, sans libelle — personne ne pouvait
                 savoir ce qu'elle designait. Elle rejoint la colonne de
                 planification, juste avant le responsable, avec un nom.

                 L'ancre est « user_id » hors de tout sous-formulaire : c'est
                 le Responsable, et il est dans la bonne colonne. -->
            <xpath expr="//field[@name='user_id'][not(ancestor::field)]"
                   position="before">
                <field name="x_studio_date_de_fin" string="Fin de fab"/>
            </xpath>
        </field>
    </record>
</odoo>
