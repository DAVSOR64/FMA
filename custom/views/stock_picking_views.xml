<odoo>
  <data>

    <record id="view_picking_form_custom_retard" model="ir.ui.view">
      <field name="name">stock.picking.form.custom.retard</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">

        <!-- "N° BL" (x_studio_n_bl) existait déjà en code, déjà exposé sur
             l'écran code-barres (view_picking_barcode_form_n_bl ci-dessous,
             T-22), mais jamais sur la fiche réception "classique", où il
             était pourtant visible en prod, juste après l'Emplacement de
             destination. -->
        <field name="location_dest_id" position="after">
          <field name="x_studio_n_bl" string="N° BL"/>
          <!-- Le projet de la vente, le meme champ que sur l'ordre de
               fabrication. Il repond a la question qu'on se pose devant un
               transfert : de quelle affaire s'agit-il ? -->
          <field name="x_studio_projet_de_la_vente"/>
        </field>

        <!-- Ajoute un onglet dédié -->
        <xpath expr="//notebook" position="inside">
          <page string="Motif de retard">
            <group>
              <field name="so_retard_motif_level1_id"/>
              <field name="so_retard_motif_level2_id"
                     domain="[('category_id', '=', so_retard_motif_level1_id)]"/>
            </group>
          </page>
        </xpath>

      </field>
    </record>

    <!-- "N° BL" doit être saisissable depuis l'écran code-barres, sans
         avoir à en sortir. Le panneau d'infos de cet écran (bouton titre
         vers "infoFormView") est une vraie vue formulaire classique
         (stock_barcode.stock_picking_barcode), éditable comme n'importe
         quelle autre, sans surcharge JS nécessaire. Le champ
         (custom/models/stock_picking.py:x_studio_n_bl) est aussi exposé au
         client JS via _get_fields_stock_barcode(). -->
    <record id="view_picking_barcode_form_n_bl" model="ir.ui.view">
      <field name="name">stock.picking.barcode.form.n.bl</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock_barcode.stock_picking_barcode"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='origin']" position="after">
          <field name="x_studio_n_bl" string="N° BL"/>
        </xpath>
      </field>
    </record>

  </data>

    <!--
        Le projet de la vente sur la LISTE des transferts, en colonne
        optionnelle : c'est la qu'on regroupe les livraisons par affaire.
        Optionnelle parce que cette liste sert aussi aux receptions et aux
        mouvements internes, ou l'affaire n'a pas de sens.
    -->
    <record id="view_picking_tree_projet_vente" model="ir.ui.view">
      <field name="name">stock.picking.list.projet.vente</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.vpicktree"/>
      <field name="arch" type="xml">
        <!-- Ajoute en fin de liste plutot qu'apres un champ precis : le
             depot n'a aucun precedent d'heritage de cette vue, et une ancre
             de plus serait une hypothese de plus a verifier au deploiement. -->
        <list position="inside">
          <field name="x_studio_projet_de_la_vente" optional="show"/>
        </list>
      </field>
    </record>
</odoo>
