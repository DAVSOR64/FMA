<odoo>
  <data>

    <record id="view_picking_form_custom_retard" model="ir.ui.view">
      <field name="name">stock.picking.form.custom.retard</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">

        <!-- Ajoute un onglet dédié -->
        <xpath expr="//notebook" position="inside">
          <page string="Motif de retard">
            <group>
              <field name="so_retard_motif_level1_id"/>
              <field name="so_retard_motif_level2_id"
                     domain="[('category_id', '=', so_retard_motif_level1_id)]"/>
            </group>
          </page>
        </xpath>

      </field>
    </record>

    <!-- "N° BL" doit être saisissable depuis l'écran code-barres, sans
         avoir à en sortir. Le panneau d'infos de cet écran (bouton titre
         vers "infoFormView") est une vraie vue formulaire classique
         (stock_barcode.stock_picking_barcode), éditable comme n'importe
         quelle autre, sans surcharge JS nécessaire. Le champ
         (custom/models/stock_picking.py:x_studio_n_bl) est aussi exposé au
         client JS via _get_fields_stock_barcode(). -->
    <record id="view_picking_barcode_form_n_bl" model="ir.ui.view">
      <field name="name">stock.picking.barcode.form.n.bl</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock_barcode.stock_picking_barcode"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='origin']" position="after">
          <field name="x_studio_n_bl" string="N° BL"/>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
