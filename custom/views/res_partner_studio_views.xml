<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reprise des champs Studio de la fiche contact dans une vue versionnee.

        Ces champs etaient jusqu'ici poses par des vues Studio : invisibles au
        code, non versionnees, perdues a la moindre regeneration. Ils sont
        desormais decrits ici.

        NE SONT PAS REPRIS les champs Studio qui ont deja un equivalent propre
        affiche par view_partner_form_custom — les remettre afficherait deux
        fois la meme information :

            x_studio_char_field_G6qIE  -> part_siren
            x_studio_bic               -> part_bic
            x_studio_iban              -> part_iban
            x_studio_affacturage       -> part_affacturage
            x_studio_allianz_nd_cover  -> part_couverture
            x_studio_allianz_nd_cover_1 -> part_date_couverture
            x_studio_allianz_eh_decision -> part_decision

        Trois champs propres existaient sans etre affiches nulle part : ils
        rejoignent la fiche ici, a la place de leur homologue Studio.
    -->
    <record id="view_partner_form_studio" model="ir.ui.view">
        <field name="name">res.partner.form.studio</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='sales_purchases']/group" position="inside">

                <group string="Identification externe">
                    <!-- Attribue par le systeme, jamais saisi. -->
                    <field name="x_studio_code" string="Code" readonly="1"/>
                    <field name="part_code_tiers" string="Code tiers"/>
                    <field name="x_studio_code_diap" string="Code Diapason"/>
                    <field name="x_studio_ref_logikal" string="Référence LOGIKAL"/>
                    <field name="x_studio_compte_proginov" string="Compte PROGINOV"/>
                    <field name="x_studio_iziqo_1" string="Présent dans IziQo"/>
                </group>

                <group string="Identité légale">
                    <field name="part_civilite" string="Forme juridique"/>
                    <field name="x_studio_code_naf" string="Code NAF"/>
                    <field name="x_studio_etablissement" string="Établissement"/>
                </group>

                <group string="Comptabilité et règlement">
                    <field name="x_studio_compte" string="Compte comptable"/>
                    <field name="x_studio_gneration_n_compte_1"
                           string="Génération automatique du n° de compte"/>
                    <!-- Le referentiel x_reglements est la source vivante : c'est
                         lui qu'alimente mode_reglement_id sur le devis et la
                         facture. Le champ Selection reste affiche le temps de la
                         bascule. -->
                    <field name="x_studio_mode_de_rglement_dsa" string="Mode de règlement"/>
                    <field name="part_mode_de_reglement" string="Mode de règlement (ancien)"/>
                    <field name="x_studio_adresse_dmat_facturation"
                           string="Adresse de facturation dématérialisée"/>
                </group>

                <group string="Encours et conditions">
                    <field name="x_studio_encours_autoris" string="Encours autorisé"/>
                    <field name="x_studio_mtt_echu" string="Montant échu"/>
                    <field name="x_studio_mtt_non_echu" string="Montant non échu"/>
                    <field name="x_studio_remise" string="Remise (%)"/>
                </group>

            </xpath>
        </field>
    </record>
</odoo>
