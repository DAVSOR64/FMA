<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fma_pricer_import_wizard_form" model="ir.ui.view">
        <field name="name">fma.pricer.import.wizard.form</field>
        <field name="model">fma.pricer.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Pricer">
                <field name="order_id" invisible="1"/>
                <field name="existing_line_count" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    Le chiffrage sera importe dans <b><field name="order_id"
                    readonly="1" nolabel="1" class="oe_inline"/></b> pour le client
                    <b><field name="partner_id" readonly="1" nolabel="1"
                    class="oe_inline"/></b>.
                    Le client et la date du devis ne sont pas ecrases par le fichier.
                </div>

                <group>
                    <field name="file" filename="filename"
                           options="{'accepted_file_extensions': '.sqlite'}"/>
                    <field name="filename" invisible="1"/>
                    <field name="description"/>
                    <field name="replace_lines"
                           invisible="existing_line_count == 0"/>
                </group>

                <div class="alert alert-warning" role="alert"
                     invisible="not replace_lines">
                    Les <field name="existing_line_count" readonly="1" nolabel="1"
                    class="oe_inline"/> lignes actuelles du devis seront supprimees
                    avant l'import.
                </div>

                <footer>
                    <button name="action_import" type="object" string="Importer"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
