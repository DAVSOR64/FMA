<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- « Opération pricer » sur le poste de charge.
         L'ancrage est « //sheet », present dans toute vue formulaire, plutot
         qu'un groupe nomme : les noms des groupes de la vue des postes
         varient d'une version a l'autre. Le champ arrive donc en bas de la
         fiche ; on le remontera une fois sa place vue. -->
    <record id="mrp_workcenter_form_pricer" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.pricer</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Import Pricer" name="pricer">
                    <field name="pricer_operation"
                           placeholder="Debit, Usinage, Montage, CU (banc), Vitrage"/>
                    <field name="pricer_site" placeholder="FMA ou F2M"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
