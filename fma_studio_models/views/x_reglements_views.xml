<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_reglements_list" model="ir.ui.view">
        <field name="name">x_reglements.list</field>
        <field name="model">x_reglements</field>
        <field name="arch" type="xml">
            <list string="Règlements">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <record id="view_x_reglements_search" model="ir.ui.view">
        <field name="name">x_reglements.search</field>
        <field name="model">x_reglements</field>
        <field name="arch" type="xml">
            <search string="Règlements"/>
        </field>
    </record>

    <record id="action_x_reglements" model="ir.actions.act_window">
        <field name="name">Réglements</field>
        <field name="res_model">x_reglements</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_x_reglements_list"/>
        <field name="search_view_id" ref="view_x_reglements_search"/>
    </record>
</odoo>
