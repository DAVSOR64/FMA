    <menuitem id="menu_x_delai_entre_operatio_tag" name="Délai entre opérations - Étiquettes" parent="menu_x_delai_entre_operatio_config" action="action_x_delai_entre_operatio_tag" sequence="10"/>
    <menuitem id="menu_x_capacite_par_poste" name="Capacité par poste" parent="mrp.menu_mrp_root" action="action_x_capacite_par_poste" sequence="92"/>
    <menuitem id="menu_x_capacite_par_poste_tag" name="Capacité par poste - Étiquettes" parent="menu_x_delai_entre_operatio_config" action="action_x_capacite_par_poste_tag" sequence="20"/>
