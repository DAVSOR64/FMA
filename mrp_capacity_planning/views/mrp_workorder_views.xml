<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_macro_forced_end" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.macro_forced_end</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- « Fin de fab » : c'est cette date-la que le metier lit et
                 corrige, pas la fin native calculee. Elle etait affichee en
                 lecture seule sous le libelle technique « Fin macro forcee »,
                 et le client ne savait pas ce qu'elle designait.
                 Renommee et rendue modifiable : la changer puis « Replanifier »
                 recale tout l'OF depuis cette date. -->
            <!-- Champ regroupe dans le bloc « Fabrication FMA »
                 porte par fma_lot_fabrication. -->
            <!-- La fin native, elle, est calculee : deux dates de fin cote a
                 cote n'apprennent rien et se contredisent des qu'on replanifie. -->
            <xpath expr="//field[@name='date_finished']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_workorder_tree_inherit_macro" model="ir.ui.view">
        <field name="name">mrp.production.workorder.tree.inherit.macro_planned_start</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="macro_planned_start" optional="show" string="Macro (début planifié)"/>
            </xpath>
        </field>
    </record>

    <!-- La séquence des opérations disparaissait dès que l'OF sortait du
         brouillon (comportement standard mrp : poignée de tri masquée hors
         draft). Le métier veut la voir en permanence, dans l'ordre
         chronologique -> on garde la poignée en brouillon (réordonnancement)
         et on affiche la valeur en lecture seule ensuite, au lieu de la
         masquer complètement. -->
    <record id="mrp_production_workorder_tree_editable_view_mo_form_inherit_sequence" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.inherit.sequence.visible</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence'][@widget='handle']" position="after">
                <field name="sequence" string="Séquence" readonly="1" column_invisible="parent.state == 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
