<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit_macro_forced_end" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.macro_forced_end</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='components_availability']" position="after">
                <field name="macro_forced_end"
                       string="Date de fin"
                       readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_workorder_tree_inherit_macro" model="ir.ui.view">
        <field name="name">mrp.production.workorder.tree.inherit.macro_planned_start</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="macro_planned_start" optional="show" string="Macro (début planifié)"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_workorder_tree_editable_view_mo_form_inherit_sequence" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.inherit.sequence.visible</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence'][@widget='handle']" position="after">
                <field name="sequence" string="Séquence" readonly="1" column_invisible="parent.state == 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
