<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_customer_files" model="ir.cron">
            <field name="name">Export Customer Files</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.cron_generate_generate_customer_files()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_export_customer_files_to_sftp_server" model="ir.cron">
            <field name="name">Send Customer Files to SFTP server</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.cron_send_customers_file_to_sftp_server()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!--
            Reprise, a lancer une seule fois. Declaree en action planifiee
            inactive : le formulaire d'une action planifiee est le seul de
            l'interface a porter un bouton « Executer manuellement », celui
            d'une action serveur n'en offre pas.

            Inactive, elle ne peut pas relancer seule un envoi complet a la
            compta.
        -->
        <record id="ir_cron_reprise_customer_files_depuis" model="ir.cron">
            <field name="name">REPRISE : fichier clients crees ou modifies depuis une date</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.action_generer_fichier_clients_depuis()</field>
            <field name="interval_number">1000</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <!--
            Date de depart de la reprise. Dans le meme bloc noupdate : une
            mise a jour du module ne doit pas ramener le 1er aout alors qu'on
            a rejoue une autre periode entre-temps.
        -->
        <record id="param_reprise_depuis" model="ir.config_parameter">
            <field name="key">fma_customer_export.reprise_depuis</field>
            <field name="value">2026-08-01</field>
        </record>
    </data>
</odoo>
