<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Retrouver les articles saisis a la main dans LOGIKAL.

         Leur reference est fabriquee par le connecteur (« ABC A26-..._LB1 ») :
         elle ne se retient pas, et elle change d'un depot a l'autre. La marque,
         elle, ne bouge pas. C'est par elle qu'on les liste.

         L'ancrage se fait sur la balise search elle-meme, et non sur un filtre
         nomme du standard : un nom de filtre qui disparait d'une version a
         l'autre ferait echouer l'installation du module. -->
    <record id="product_template_search_article_libre" model="ir.ui.view">
        <field name="name">product.template.search.article.libre</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter string="Articles libres LOGIKAL"
                        name="fma_article_libre"
                        domain="[('fma_article_libre', '=', True)]"/>
                <separator/>
                <filter string="Profilés" name="fma_nature_profile"
                        domain="[('fma_nature_logikal', '=', 'profile')]"/>
                <filter string="Quincaillerie" name="fma_nature_article"
                        domain="[('fma_nature_logikal', '=', 'article')]"/>
                <filter string="Vitrages" name="fma_nature_glass"
                        domain="[('fma_nature_logikal', '=', 'glass')]"/>
                <separator/>
                <filter string="Vitrage sur palette (chantier)"
                        name="fma_vitrage_palette"
                        domain="[('fma_destination_vitrage', '=', 'palette')]"/>
                <filter string="Vitrage sur chariot (atelier)"
                        name="fma_vitrage_chariot"
                        domain="[('fma_destination_vitrage', '=', 'chariot')]"/>
                <group name="fma_groupby_article_libre">
                    <filter string="Article libre LOGIKAL"
                            name="groupby_fma_article_libre"
                            context="{'group_by': 'fma_article_libre'}"/>
                    <filter string="Nature LOGIKAL"
                            name="groupby_fma_nature_logikal"
                            context="{'group_by': 'fma_nature_logikal'}"/>
                    <filter string="Destination du vitrage"
                            name="groupby_fma_destination_vitrage"
                            context="{'group_by': 'fma_destination_vitrage'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ANCRE SUR UN CHAMP STANDARD, et c'est deliberé. Le groupe « Logikal »
         ou la valeur serait le mieux placee est pose par une vue du module
         « custom » : s'y accrocher ferait dependre ce module d'une vue SŒUR,
         appliquee selon (priorite, id) — l'instabilite exacte qui a casse la
         production le mois dernier. categ_id appartient a la vue standard et
         ne bougera pas. -->
    <record id="view_product_template_form_conditionnement" model="ir.ui.view">
        <field name="name">product.template.form.fma.conditionnement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="fma_conditionnement"
                       invisible="not fma_conditionnement"/>
                <!-- La destination etait LUE, ECRITE et EXPLOITEE (elle
                     decoupe les bons d'achat et sort le vitrage de chantier
                     du lot) sans apparaitre sur aucun ecran. On ne pouvait
                     donc pas verifier qu'une affaire avait bien ete reprise,
                     ni corriger une saisie. Affichee seulement quand elle est
                     renseignee : les profiles et la quincaillerie n'en ont
                     pas. -->
                <field name="fma_destination_vitrage"
                       invisible="not fma_destination_vitrage"/>
            </xpath>
        </field>
    </record>

</odoo>
