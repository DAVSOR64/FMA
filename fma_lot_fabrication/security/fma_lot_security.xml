<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="fma_lot_fabrication_company_rule" model="ir.rule">
            <field name="name">Lot de fabrication : multi-societes</field>
            <field name="model_id" ref="model_fma_lot_fabrication"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="fma_lot_fabrication_line_company_rule" model="ir.rule">
            <field name="name">Ligne de lot : multi-societes</field>
            <field name="model_id" ref="model_fma_lot_fabrication_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="fma_lot_material_line_company_rule" model="ir.rule">
            <field name="name">Besoin matiere : multi-societes</field>
            <field name="model_id" ref="model_fma_lot_material_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
