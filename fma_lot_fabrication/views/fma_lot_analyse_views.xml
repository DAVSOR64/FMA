<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La repartition des achats par lot.
         Les montants sont ceux COMMANDES, famille par famille, et ils sont
         stockes : Odoo les croise donc nativement, sans vue SQL. Trois axes
         utiles — l'affaire, le client, et la date de fin de fab du lot, qui
         est la seule date qui situe un lot dans le temps. -->
    <record id="view_fma_lot_analyse_pivot" model="ir.ui.view">
        <field name="name">fma.lot.fabrication.analyse.pivot</field>
        <field name="model">fma.lot.fabrication</field>
        <field name="arch" type="xml">
            <pivot string="Coûts par lot" sample="1">
                <field name="ordo_commande_id" type="row"/>
                <field name="ordo_date_sortie" interval="month" type="col"/>
                <field name="ordo_cout_profil" type="measure"/>
                <field name="ordo_cout_vitrage" type="measure"/>
                <field name="ordo_cout_quincaillerie" type="measure"/>
                <field name="ordo_cout_total" type="measure"/>
                <field name="ordo_heure_totale" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fma_lot_analyse_graph" model="ir.ui.view">
        <field name="name">fma.lot.fabrication.analyse.graph</field>
        <field name="model">fma.lot.fabrication</field>
        <field name="arch" type="xml">
            <graph string="Coûts par lot" type="bar" stacked="1" sample="1">
                <field name="ordo_date_sortie" interval="month"/>
                <field name="ordo_cout_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_fma_lot_analyse_search" model="ir.ui.view">
        <field name="name">fma.lot.fabrication.analyse.search</field>
        <field name="model">fma.lot.fabrication</field>
        <field name="arch" type="xml">
            <search string="Coûts par lot">
                <field name="name" string="Lot"/>
                <field name="ordo_commande_id" string="Affaire"/>
                <field name="partner_id"/>
                <filter name="ordo_en_cours" string="En cours"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <filter name="grp_affaire" string="Affaire"
                        context="{'group_by': 'ordo_commande_id'}"/>
                <filter name="grp_client" string="Client"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="grp_sortie" string="Lot fini le"
                        context="{'group_by': 'ordo_date_sortie:month'}"/>
                <filter name="grp_debit" string="Débit prévu le"
                        context="{'group_by': 'ordo_date_debit:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_fma_lot_analyse" model="ir.actions.act_window">
        <field name="name">Coûts par lot</field>
        <field name="res_model">fma.lot.fabrication</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fma_lot_analyse_search"/>
        <field name="context">{'search_default_grp_affaire': 1}</field>
    </record>

    <record id="action_fma_lot_analyse_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_fma_lot_analyse_pivot"/>
        <field name="act_window_id" ref="action_fma_lot_analyse"/>
    </record>

    <record id="action_fma_lot_analyse_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_fma_lot_analyse_graph"/>
        <field name="act_window_id" ref="action_fma_lot_analyse"/>
    </record>

    <menuitem id="menu_fma_lot_analyse"
              name="Coûts par lot"
              parent="fma_mrp_ordonnancement.menu_fma_ordonnancement_root"
              action="action_fma_lot_analyse"
              groups="mrp.group_mrp_user"
              sequence="20"/>

</odoo>
