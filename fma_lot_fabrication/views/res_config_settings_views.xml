<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_lot" model="ir.ui.view">
        <field name="name">res.config.settings.form.fma.lot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- En v19 les parametres d'application sont declares avec la
                 balise <app>, pas un <div data-key>. On ancre sur l'app
                 plutot que sur un nom de block interne a mrp. -->
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Lots de fabrication" name="fma_lot_container">
                    <setting id="fma_lot_max_setting"
                             string="Menuiseries max par lot"
                             help="Plafond impose par l'optimisation du debit. 0 = pas de limite.">
                        <field name="fma_lot_max_menuiserie"/>
                    </setting>
                    <setting id="fma_lot_avance_matiere_setting"
                             string="Délai prépa MP — DELMP (jours ouvrés)"
                             help="Jours OUVRÉS entre la sortie de la quincaillerie et du vitrage vers la Pré-Fab et le début de l'OF de débit. Les profilés ne sont pas concernés : ils suivent l'OF de débit.">
                        <field name="fma_lot_jours_avance_matiere"/>
                    </setting>
                    <setting id="fma_lot_securite_livraison_setting"
                             string="Délai logistique — DELLOG (jours ouvrés)"
                             help="Jours OUVRÉS entre la fin de fabrication et la livraison engagée. Ne cale que le premier lot d'une affaire ; les suivants se calent sur son débit.">
                        <field name="fma_lot_jours_securite_livraison"/>
                    </setting>
                    <setting id="fma_lot_decalage_lots_setting"
                             string="Décalage entre lots — X (jours ouvrés)"
                             help="Le lot 2 d'une affaire débite ce nombre de jours OUVRÉS avant le lot 1, le lot 3 avant le lot 2, et ainsi de suite.">
                        <field name="fma_lot_decalage_entre_lots"/>
                    </setting>
                    <setting id="fma_lot_product_setting"
                             string="Article debite par defaut"
                             help="« Debit du lot » : l'article que porte l'OF de debit, pour le nombre de menuiseries du lot. Generique, non suivi en stock ; les ensembles debites sortent en sous-produits.">
                        <field name="fma_lot_product_debit_id"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
