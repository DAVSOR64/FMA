<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_lot" model="ir.ui.view">
        <field name="name">mrp.production.form.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_fabrication_id"
                       options="{'no_create': True}"
                       readonly="state not in ('draft', 'confirmed')"/>
                <field name="lot_production_type" readonly="1"
                       invisible="not lot_production_type"/>
                <field name="lot_sale_line_id" readonly="1"
                       invisible="lot_production_type != 'assemblage'"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_lot" model="ir.ui.view">
        <field name="name">mrp.production.list.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="lot_fabrication_id" optional="show"/>
                <field name="lot_production_type" optional="show" widget="badge"/>
            </field>
        </field>
    </record>

    <record id="view_mrp_production_filter_lot" model="ir.ui.view">
        <field name="name">mrp.production.search.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="lot_fabrication_id"/>
                <separator/>
                <filter name="filter_lot_debit" string="OF Debit"
                        domain="[('lot_production_type', '=', 'debit')]"/>
                <filter name="filter_lot_assemblage" string="OF Assemblage"
                        domain="[('lot_production_type', '=', 'assemblage')]"/>
                <group name="group_by_lot">
                    <filter name="group_lot_fabrication" string="Lot de fabrication"
                            domain="[]" context="{'group_by': 'lot_fabrication_id'}"/>
                    <filter name="group_lot_type" string="Type dans le lot"
                            domain="[]" context="{'group_by': 'lot_production_type'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Formulaire OF en deux colonnes.
         Priorite 99 : cette vue s'applique APRES celles de custom,
         fma_atelier et mrp_capacity_planning, dont elle deplace les champs.
         Sans cela, les elements qu'elle cible n'existeraient pas encore.

         On DEPLACE les champs natifs (position="move") au lieu de les
         recopier : un champ ne peut pas figurer deux fois dans un
         formulaire. Les quatre insertions existantes restent donc en place,
         elles ne font que poser les champs que cette vue range ensuite. -->
    <record id="mrp_production_form_view_deux_colonnes" model="ir.ui.view">
        <field name="name">mrp.production.form.deux.colonnes.fma</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id'][not(ancestor::field)]"
                   position="before">
                <group name="fma_of_colonnes">
                    <group string="Fabrication" name="fma_of_fabrication"/>
                    <group string="Planification" name="fma_of_planification"/>
                </group>
            </xpath>

            <xpath expr="//group[@name='fma_of_fabrication']" position="inside">
                <xpath expr="//field[@name='product_id'][not(ancestor::field)]"
                       position="move"/>
                <xpath expr="//field[@name='lot_fabrication_id']" position="move"/>
                <xpath expr="//field[@name='lot_production_type']" position="move"/>
                <xpath expr="//field[@name='bom_id'][not(ancestor::field)]"
                       position="move"/>
                <xpath expr="//field[@name='lot_sale_line_id']" position="move"/>
            </xpath>

            <xpath expr="//group[@name='fma_of_planification']" position="inside">
                <xpath expr="//field[@name='date_start'][not(ancestor::field)]"
                       position="move"/>
                <xpath expr="//field[@name='macro_forced_end']" position="move"/>
                <xpath expr="//field[@name='atelier_id'][not(ancestor::field)]"
                       position="move"/>
                <xpath expr="//field[@name='x_studio_niveau_de_complexite']"
                       position="move"/>
                <xpath expr="//field[@name='user_id'][not(ancestor::field)]"
                       position="move"/>
            </xpath>

        </field>
    </record>

</odoo>
