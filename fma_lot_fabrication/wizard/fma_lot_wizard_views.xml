<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fma_lot_wizard_form" model="ir.ui.view">
        <field name="name">fma.lot.wizard.form</field>
        <field name="model">fma.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Mise en lot">
                <field name="order_id" invisible="1"/>
                <field name="company_id" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    Renseignez, pour chaque ligne, le <b>numero de lot</b> et la
                    <b>quantite</b> a y placer. Un numero inconnu cree le lot ;
                    un numero existant complete le lot.
                    <span invisible="max_menuiserie == 0">
                        Plafond : <field name="max_menuiserie" readonly="1" nolabel="1"/>
                        menuiseries par lot.
                    </span>
                </div>

                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="date_planned_start"/>
                    </group>
                </group>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="sequence" column_invisible="1"/>
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="description" readonly="1" optional="show"/>
                        <field name="qty_ordered" readonly="1" optional="hide"/>
                        <field name="qty_lot" readonly="1" optional="hide"/>
                        <field name="qty_to_lot" readonly="1"/>
                        <field name="lot_ref"/>
                        <field name="lot_id" optional="hide"
                               options="{'no_create': True}"/>
                        <field name="qty_in_lot"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply" type="object" string="Creer les lots"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_autofill" type="object"
                            string="Repartition automatique" class="btn-secondary"
                            help="Enchaine les menuiseries en lots pleins, sans depasser le plafond."/>
                    <button string="Annuler" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fma_lot_wizard" model="ir.actions.act_window">
        <field name="name">Mise en lot</field>
        <field name="res_model">fma.lot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
