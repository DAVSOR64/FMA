<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Groupe restreignant la saisie sur l'écran d'ordonnancement. Sans
         category_id volontairement : le module ne dépend ainsi d'aucun xml_id
         de catégorie, dont les identifiants varient d'une version à l'autre. -->
    <record id="group_fma_modif_ordo" model="res.groups">
        <field name="name">Modif Ordo</field>
        <field name="comment">Autorise la saisie des commentaires sur le tableau d'ordonnancement FMA. Sans ce droit, l'écran est consultable mais non modifiable.</field>
    </record>
</odoo>
