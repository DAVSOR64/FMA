<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Barèmes heures/repère -> score, onglet SEQUENCAGE B35:C61.
         Borne basse incluse, borne haute exclue, borne haute à 0 pour la
         dernière tranche. Modifier une valeur ici déclenche le recalcul
         des scores sur tous les OF ouverts (voir fma.bareme.score). -->
    <record id="bareme_debit_1" model="fma.bareme.score">
        <field name="poste_type">debit</field>
        <field name="borne_min">0</field>
        <field name="borne_max">0.25</field>
        <field name="score">0</field>
    </record>
