<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filet de sécurité. Les recalculs sont normalement déclenchés au fil de
         l'eau (achat, réception, barème, typage de poste, famille fournisseur).
         Ce cron rattrape ce qui échappe à ces déclencheurs : imports en masse,
         écritures directes en base, modules tiers. -->
    <record id="cron_fma_recalcul_ordonnancement" model="ir.cron">
        <field name="name">FMA : recalcul ordonnancement des OF</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model._cron_fma_recalcul_ordonnancement()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
