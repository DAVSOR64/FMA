<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Niveaux de complexité, onglet SEQUENCAGE du classeur FMA.
         Les poids A=1, B=2, C=3 et M non pondéré reprennent la formule U2
         du TDB_SAISIE. Ils sont modifiables sans développement. -->
    <record id="niveau_a" model="fma.complexite.niveau">
        <field name="code">A</field>
        <field name="name">Simple</field>
        <field name="poids">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="niveau_b" model="fma.complexite.niveau">
        <field name="code">B</field>
        <field name="name">Intermédiaire</field>
        <field name="poids">2</field>
        <field name="sequence">20</field>
    </record>

    <record id="niveau_c" model="fma.complexite.niveau">
        <field name="code">C</field>
        <field name="name">Complexe</field>
        <field name="poids">3</field>
        <field name="sequence">30</field>
    </record>

    <record id="niveau_m" model="fma.complexite.niveau">
        <field name="code">M</field>
        <field name="name">Mur rideau / verrière</field>
        <field name="poids">0</field>
        <field name="sequence">40</field>
    </record>

</odoo>
