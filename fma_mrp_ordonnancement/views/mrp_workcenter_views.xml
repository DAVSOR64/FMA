<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Écran de typage dédié plutôt qu'une surcharge du formulaire standard :
         le module ne dépend ainsi d'aucun xml_id de vue de mrp, dont les
         identifiants varient d'une version à l'autre. Le typage est une
         opération de paramétrage, faite une fois puis rarement retouchée ;
         la saisie en liste éditable est de toute façon plus rapide. -->
    <record id="view_mrp_workcenter_fma_list" model="ir.ui.view">
        <field name="name">mrp.workcenter.fma.list</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list string="Typage des postes de charge" editable="bottom"
                  create="false" delete="false">
                <field name="name" readonly="1"/>
                <field name="fma_poste_type"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_workcenter_fma" model="ir.actions.act_window">
        <field name="name">Typage des postes de charge</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mrp_workcenter_fma_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun poste de charge</p>
            <p>Le type de poste détermine sur quel champ « Heures … » de l'OF
               les ordres de travail sont ventilés, et quel barème de score
               s'applique. Un poste non typé n'est compté nulle part.</p>
        </field>
    </record>
</odoo>
