<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_iziqo_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.iziqo.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Iziqo" string="Iziqo" name="iziqo_sync">
                    <block title="Connexion à l'API Iziqo" name="iziqo_sync_connection">
                        <setting string="Authentification">
                            <field name="iziqo_auth_type"/>
                            <div class="content-group mt16"
                                 invisible="iziqo_auth_type not in ('bearer', 'apikey')">
                                <div class="row">
                                    <label for="iziqo_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="iziqo_api_key" password="1"/>
                                </div>
                                <div class="row" invisible="iziqo_auth_type != 'apikey'">
                                    <label for="iziqo_api_key_header" class="col-lg-4 o_light_label"/>
                                    <field name="iziqo_api_key_header"/>
                                </div>
                            </div>
                            <div class="content-group mt16"
                                 invisible="iziqo_auth_type != 'basic'">
                                <div class="row">
                                    <label for="iziqo_login" class="col-lg-4 o_light_label"/>
                                    <field name="iziqo_login"/>
                                </div>
                                <div class="row">
                                    <label for="iziqo_password" class="col-lg-4 o_light_label"/>
                                    <field name="iziqo_password" password="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Tester la connexion"
                                 help="Appel GET en lecture seule sur chaque collection configurée : ne crée rien dans Iziqo.">
                            <button name="action_iziqo_test_connection" type="object"
                                    string="Tester l'accès à l'API"
                                    class="btn-secondary"/>
                        </setting>
                    </block>

                    <block title="Clients" name="iziqo_sync_customers">
                        <setting string="URL de la collection clients"
                                 help="POST {url} à la création, PATCH {url}/{identifiant} à la modification. Laisser vide désactive la synchronisation des clients.">
                            <field name="iziqo_api_url"
                                   placeholder="https://api.iziqo.fr/iziqo-api-v2/customers"/>
                        </setting>
                        <setting string="Identifiant de la ressource"
                                 help="Valeur placée dans l'URL du PATCH.">
                            <field name="iziqo_identifier_field"/>
                        </setting>
                        <setting string="Périmètre"
                                 help="Dans tous les cas, seules les sociétés ayant un SIRET sont envoyées.">
                            <field name="iziqo_scope"/>
                        </setting>
                        <setting string="Synchronisation complète"
                                 help="Met toutes les sociétés du périmètre en file d'attente. Utile au premier chargement des clients historiques.">
                            <button name="action_iziqo_sync_all" type="object"
                                    string="Mettre tous les clients en file"
                                    class="btn-secondary"/>
                        </setting>
                    </block>

                    <block title="Commerciaux" name="iziqo_sync_employees">
                        <setting string="URL de la collection commerciaux"
                                 help="Même contrat que les clients : POST à la création, PATCH {url}/{identifiant} à la modification. Laisser vide désactive la synchronisation des commerciaux.">
                            <field name="iziqo_employee_api_url"
                                   placeholder="https://api.iziqo.fr/iziqo-api-v2/salespeople"/>
                        </setting>
                        <setting string="Identifiant du commercial">
                            <field name="iziqo_employee_identifier_field"/>
                        </setting>
                        <setting string="Périmètre">
                            <field name="iziqo_employee_scope"/>
                            <div class="content-group mt16"
                                 invisible="iziqo_employee_scope != 'department'">
                                <div class="row">
                                    <label for="iziqo_employee_department" class="col-lg-4 o_light_label"/>
                                    <field name="iziqo_employee_department"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Synchronisation complète"
                                 help="À lancer avant celle des clients : le payload client référence le commercial par son ID Odoo.">
                            <button name="action_iziqo_sync_all_employees" type="object"
                                    string="Mettre tous les commerciaux en file"
                                    class="btn-secondary"/>
                        </setting>
                    </block>

                    <block title="Comportement de la synchronisation"
                           name="iziqo_sync_behaviour">
                        <setting string="Envoi immédiat">
                            <field name="iziqo_realtime"/>
                        </setting>
                        <setting string="Timeout HTTP">
                            <field name="iziqo_timeout"/>
                        </setting>
                        <setting string="Tentatives maximum">
                            <field name="iziqo_max_attempts"/>
                        </setting>
                        <setting string="Conservation du journal">
                            <field name="iziqo_keep_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
