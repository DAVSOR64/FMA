<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="iziqo_sync_job_view_list" model="ir.ui.view">
        <field name="name">iziqo.sync.job.list</field>
        <field name="model">iziqo.sync.job</field>
        <field name="arch" type="xml">
            <list string="Synchronisations Iziqo" create="false"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'pending' and attempt_count &gt; 0"
                  decoration-muted="state == 'cancelled'">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="operation"/>
                <field name="origin" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="next_attempt_date" optional="show"/>
                <field name="last_attempt_date" optional="hide"/>
                <field name="response_code"/>
                <field name="error_message" optional="show"/>
                <button name="action_retry" type="object" icon="fa-refresh"
                        title="Relancer" invisible="state == 'done'"/>
                <button name="action_cancel" type="object" icon="fa-times"
                        title="Annuler" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="iziqo_sync_job_view_form" model="ir.ui.view">
        <field name="name">iziqo.sync.job.form</field>
        <field name="model">iziqo.sync.job</field>
        <field name="arch" type="xml">
            <form string="Synchronisation Iziqo" create="false">
                <header>
                    <button name="action_retry" type="object" string="Relancer"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="operation"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="attempt_count"/>
                            <field name="last_attempt_date"/>
                            <field name="next_attempt_date"/>
                            <field name="http_method"/>
                            <field name="endpoint"/>
                            <field name="response_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Erreur" name="error">
                            <field name="error_message"/>
                        </page>
                        <page string="Réponse Iziqo" name="response">
                            <field name="response_message"/>
                        </page>
                        <page string="Payload envoyé" name="payload">
                            <field name="payload"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="iziqo_sync_job_view_search" model="ir.ui.view">
        <field name="name">iziqo.sync.job.search</field>
        <field name="model">iziqo.sync.job</field>
        <field name="arch" type="xml">
            <search string="Synchronisations Iziqo">
                <field name="partner_id"/>
                <field name="error_message"/>
                <filter name="filter_pending" string="À envoyer"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_error" string="En échec"
                        domain="[('state', '=', 'error')]"/>
                <filter name="filter_done" string="Envoyées"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_today" string="Aujourd'hui"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_operation" string="Opération" context="{'group_by': 'operation'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="iziqo_sync_job_action" model="ir.actions.act_window">
        <field name="name">Synchronisations Iziqo</field>
        <field name="res_model">iziqo.sync.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_filter_error': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune synchronisation Iziqo</p>
            <p>Les fiches clients créées ou modifiées apparaissent ici le temps de leur envoi.</p>
        </field>
    </record>

    <menuitem id="iziqo_sync_menu_root" name="Synchronisation Iziqo"
              parent="base.menu_administration" sequence="91"/>

    <menuitem id="iziqo_sync_job_menu" name="File d'attente et journal"
              parent="iziqo_sync_menu_root" action="iziqo_sync_job_action"
              sequence="10"/>

    <record id="action_iziqo_sync_partners" model="ir.actions.server">
        <field name="name">Synchroniser vers Iziqo</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_iziqo_sync_now()</field>
    </record>

    <record id="action_iziqo_sync_all_partners" model="ir.actions.server">
        <field name="name">Iziqo - Synchronisation complète des clients</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.action_iziqo_sync_all()</field>
    </record>
</odoo>
