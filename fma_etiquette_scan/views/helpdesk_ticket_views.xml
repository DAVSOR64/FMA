<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_ticket_form_fma_serie" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.fma.serie</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_fma_voir_serie" type="object"
                        class="oe_stat_button" icon="fa-barcode"
                        invisible="not fma_serial_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Menuiserie</span>
                    </div>
                </button>
                <button name="action_fma_voir_of" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        invisible="not fma_production_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Ordre de</span>
                        <span class="o_stat_text">fabrication</span>
                    </div>
                </button>
                <button name="action_fma_voir_lot" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not fma_lot_fabrication_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Lot de</span>
                        <span class="o_stat_text">fabrication</span>
                    </div>
                </button>
                <button name="action_fma_voir_commande" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not fma_sale_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Commande</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Menuiserie" name="fma_menuiserie">
                    <group>
                        <group>
                            <field name="fma_serial_id"
                                   options="{'no_create': True}"/>
                            <field name="fma_product_id"/>
                            <field name="fma_repere"/>
                            <field name="fma_production_id"/>
                            <field name="fma_lot_fabrication_id"/>
                        </group>
                        <group>
                            <field name="fma_sale_order_id"/>
                            <field name="fma_affaire"/>
                            <field name="fma_chantier"/>
                            <field name="fma_date_fabrication"/>
                            <field name="fma_livraison"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_helpdesk_ticket_list_fma_sav" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.fma.sav</field>
        <field name="model">helpdesk.ticket</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Tickets SAV par menuiserie">
                <field name="create_date" string="Déclaré le"/>
                <field name="name"/>
                <field name="fma_serial_id"/>
                <field name="fma_product_id" optional="hide"/>
                <field name="fma_sale_order_id"/>
                <field name="fma_lot_fabrication_id"/>
                <field name="fma_production_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_fma_ticket_sav" model="ir.actions.act_window">
        <field name="name">Tickets SAV par menuiserie</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_helpdesk_ticket_list_fma_sav"/>
        <field name="domain">[('fma_serial_id', '!=', False)]</field>
    </record>

</odoo>
