<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Une etiquette par menuiserie. La meme, qu'on l'imprime depuis le
         lot (tout le paquet), depuis un ordre ou depuis le numero de serie :
         les trois entrees appellent le meme gabarit.

         Il n'y a pas de variante « casier ». Le casier et la menuiserie
         portent le meme numero : deux etiquettes differentes auraient fait
         croire a deux objets. On imprime la meme en deux exemplaires. -->
    <record id="action_report_etiquette_of" model="ir.actions.report">
        <field name="name">Étiquette menuiserie / casier</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fma_etiquette_scan.report_etiquette_of</field>
        <field name="report_file">fma_etiquette_scan.report_etiquette_of</field>
        <field name="paperformat_id" ref="paperformat_etiquette_menuiserie"/>
        <field name="print_report_name">'Etiquettes - %s' % (object.lot_fabrication_id.display_name or object.name)</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_etiquette_serie" model="ir.actions.report">
        <field name="name">Étiquette menuiserie / casier</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fma_etiquette_scan.report_etiquette_serie</field>
        <field name="report_file">fma_etiquette_scan.report_etiquette_serie</field>
        <field name="paperformat_id" ref="paperformat_etiquette_menuiserie"/>
        <field name="print_report_name">'Etiquette - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <!-- L'etiquette, sur les 96 x 31 mm utiles du rouleau de l'atelier.
         Elle porte ce que le metier a demande : numero et nom de l'affaire,
         numero de lot, repere, rang de l'exemplaire quand le repere en
         compte plusieurs, client, dimensions, et le code-barres.

         LE CODE-BARRES PORTE LE NUMERO DE SERIE : c'est la MENUISERIE que
         l'etiquette designe, pas le document qui l'a fabriquee. Un seul code
         tient sur cette hauteur ; le numero d'ordre reste ecrit en clair a
         cote, lisible et saisissable.

         Un ordre sans numero de serie — un habillage — met son propre numero
         dans le code-barres : c'est le seul identifiant qu'il ait.

         IL N'Y A PLUS DE QR CODE SAV. Il occupait un tiers du 100 x 150 ; le
         metier a tranche de s'en passer plutot que de perdre le format. Le
         lien SAV existe toujours, sur la fiche du numero de serie.

         Tout est en nowrap et en table-layout fixe : sur 31 mm utiles, une
         ligne qui se replie en pousse une autre hors de l'etiquette. Un
         libelle trop long est coupe, il n'ecrase rien.

         etq.get(...) et non etq[...] : une etiquette se construit a DEUX
         endroits — depuis le numero de serie, et depuis l'ordre quand
         l'article n'est pas suivi. Une cle ajoutee d'un cote et oubliee de
         l'autre faisait tomber l'impression entiere sur un KeyError, au lieu
         de laisser un champ vide. -->
    <template id="etiquette_menuiserie">
        <div class="page" style="page-break-after: always; font-family: Arial, Helvetica, sans-serif; line-height: 1.15;">
            <table style="width: 100%; table-layout: fixed;">
                <tr>
                    <td style="font-size: 10px; font-weight: bold; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('affaire_ligne')"/>
                    <td style="width: 20mm; font-size: 10px; text-align: right; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('lot_court')"/>
                </tr>
            </table>

            <table style="width: 100%; table-layout: fixed;">
                <tr>
                    <td style="font-size: 16px; font-weight: bold; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('repere') or '-'"/>
                    <td style="width: 18mm; font-size: 16px; font-weight: bold; text-align: right; white-space: nowrap;"
                        t-out="etq.get('exemplaire')"/>
                </tr>
            </table>

            <table style="width: 100%; table-layout: fixed;">
                <tr>
                    <td style="font-size: 9px; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('client')"/>
                    <td style="width: 32mm; font-size: 10px; font-weight: bold; text-align: right; white-space: nowrap;"
                        t-out="etq.get('dimensions')"/>
                </tr>
            </table>

            <div style="text-align: center; margin-top: 0.5mm;">
                <img t-if="etq.get('barcode_src')" alt="Code-barres du numéro de série"
                     style="width: 100%; height: 10mm;" t-att-src="etq.get('barcode_src')"/>
                <img t-if="etq.get('serie_qr_src')" alt="QR code du numéro de série"
                     style="width: 10mm; height: 10mm;" t-att-src="etq.get('serie_qr_src')"/>
            </div>

            <table style="width: 100%; table-layout: fixed;">
                <tr>
                    <td style="font-size: 9px; font-weight: bold; letter-spacing: 0.3px; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('serie')"/>
                    <td style="width: 30mm; font-size: 9px; text-align: right; white-space: nowrap; overflow: hidden;"
                        t-out="etq.get('of')"/>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_etiquette_of">
        <t t-call="web.basic_layout">
            <t t-foreach="docs._fma_etiquettes()" t-as="etq">
                <t t-call="fma_etiquette_scan.etiquette_menuiserie"/>
            </t>
        </t>
    </template>

    <template id="report_etiquette_serie">
        <t t-call="web.basic_layout">
            <t t-foreach="docs._fma_etiquettes()" t-as="etq">
                <t t-call="fma_etiquette_scan.etiquette_menuiserie"/>
            </t>
        </t>
    </template>

</odoo>
