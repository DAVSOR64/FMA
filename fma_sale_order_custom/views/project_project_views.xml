<odoo>

    <!-- Le chantier sur la fiche projet : code affaire, chiffrage, vendu.
         L'ancrage est « //sheet » et non un groupe nomme : les noms des
         groupes de la vue projet varient d'une version d'Odoo a l'autre,
         alors que la presence d'un sheet, elle, est certaine. Le bloc arrive
         donc en bas de la fiche ; on le remontera une fois sa place vue. -->
    <record id="view_project_form_chantier_fma" model="ir.ui.view">
        <field name="name">project.project.form.chantier.fma</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Chantier" name="fma_chantier">
                    <group>
                        <field name="x_code_affaire"/>
                        <field name="x_currency_id" invisible="1"/>
                        <field name="x_montant_chiffrage"/>
                        <field name="x_tranche_count"/>
                    </group>
                    <group>
                        <field name="x_montant_vendu"/>
                        <!-- Masque tant que le chiffrage n'est pas saisi : la
                             soustraction n'aurait rien a dire. -->
                        <field name="x_reste_a_vendre"
                               invisible="not x_montant_chiffrage"/>
                        <field name="x_montant_facture"/>
                        <field name="x_reste_a_facturer"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Ecran dedie « Chantiers ».
         Une vue autonome plutot qu'une greffe sur la liste native des
         projets : celle-ci sert au pilotage des taches, ses colonnes n'ont
         rien a voir, et l'heritage supposerait de parier sur l'identifiant
         d'une vue standard.
         C'est ici que se lit le portefeuille : les totaux en bas de colonne
         donnent le cumul sur tous les chantiers affiches, et donc sur ceux
         que le filtre retient. -->
    <record id="view_project_list_chantier_fma" model="ir.ui.view">
        <field name="name">project.project.list.chantier.fma</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="Chantiers" create="false">
                <field name="x_currency_id" column_invisible="1"/>
                <field name="x_code_affaire"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="x_tranche_count" sum="Tranches"/>
                <field name="x_montant_chiffrage" sum="Chiffré"/>
                <field name="x_montant_vendu" sum="Vendu"/>
                <field name="x_reste_a_vendre" sum="Reste à vendre"/>
                <field name="x_montant_facture" sum="Facturé"/>
                <field name="x_reste_a_facturer" sum="Reste à facturer"/>
            </list>
        </field>
    </record>

    <record id="view_project_search_chantier_fma" model="ir.ui.view">
        <field name="name">project.project.search.chantier.fma</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="Chantiers">
                <field name="x_code_affaire"/>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="chiffres" string="Chiffrés"
                        domain="[('x_montant_chiffrage', '&gt;', 0)]"/>
                <filter name="a_vendre" string="Reste à vendre"
                        domain="[('x_reste_a_vendre', '&gt;', 0)]"/>
                <filter name="a_facturer" string="Reste à facturer"
                        domain="[('x_reste_a_facturer', '&gt;', 0)]"/>
                <filter name="a_tranches" string="À tranches"
                        domain="[('x_tranche_count', '&gt;', 1)]"/>
                <!-- Groupe sans attribut : « expand » et « string » ont ete
                     retires des groupes de vue search en v19, et le depot
                     porte deja les correctifs qui les avaient supprimes
                     ailleurs. C'est l'idiome utilise par fma_mrp_dashboard. -->
                <group>
                    <filter name="par_client" string="Client"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="par_responsable" string="Responsable"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_chantier_fma" model="ir.actions.act_window">
        <field name="name">Chantiers</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_list_chantier_fma"/>
        <field name="search_view_id" ref="view_project_search_chantier_fma"/>
    </record>

    <menuitem id="menu_project_chantier_fma"
              name="Chantiers"
              parent="sale.sale_menu_root"
              action="action_project_chantier_fma"
              sequence="89"/>

</odoo>
