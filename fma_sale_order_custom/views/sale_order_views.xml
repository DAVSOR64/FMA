<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.view.order.form.inherit.fma.sale.order.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Modification de la barre d'état -->
            <xpath expr="//header/field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,sent,validated,sale"/>
            </xpath>

            <!-- Bouton "Valider" inséré après le bouton "Envoyer la facture PRO FORMA" -->
            <xpath expr="//header/button[@name='action_quotation_send'][2]" position="after">
                <button name="action_validation" string="Validé" type="object"
                    invisible="state in ['cancel', 'validated', 'sale', 'done']"/>
            </xpath>

            <!-- Bouton "Confirmer" inséré dans la bonne position -->
            <xpath expr="//header/button[@name='action_quotation_send'][1]" position="after">
                <button name="action_confirm" string="Confirmer" type="object" class="btn-primary"
                    invisible="state not in ('send', 'draft', 'validated')"/>
            </xpath>

            <!-- Modifier les attributs du bouton "Confirmer" -->
            <xpath expr="//header/button[@name='action_confirm'][1]" position="attributes">
                <attribute name="invisible">state not in ['validated']</attribute>
            </xpath>

            <!-- Ajout du champ invisible pour "disable_confirm_button" -->
            <xpath expr="//sheet" position="inside">
                <field name="disable_confirm_button" invisible="1"/>
            </xpath>

            <!-- Ajout du champ "date_bpe" après "tag_ids" -->
            <!-- Gamme/Série : champs déjà déclarés (models/sale_order.py) mais
                 absents de toute vue au portage Studio -> rendus visibles.
                 La Série est filtrée par la Gamme sélectionnée (relation
                 x_serie_mtn.x_studio_gamme_de_la_srie), filtre attendu. -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="date_bpe"/>
                <field name="x_studio_gamme"/>
                <field name="x_studio_srie"
                       domain="[('x_studio_gamme_de_la_srie', '=', x_studio_gamme)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit" model="ir.ui.view">
        <field name="name">sale.view.sales.order.filter.inherit.fma.sale.order.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <!-- Ajout du filtre sur "Date BPE" -->
            <xpath expr="//filter[@name='order_month']" position="after">
                <filter name="so_date_bpe" string="Date BPE" domain="[]" context="{'group_by': 'so_date_bpe'}"/>
            </xpath>
        </field>
    </record>

    <!--
        Complements a l'onglet Chronologie cree par le module « custom ».
        Ces champs sont declares ici, et « custom » ne peut pas dependre de ce
        module (il en est la dependance) : c'est donc a cette vue-ci, chargee
        apres, de les poser.
    -->
    <record id="view_order_form_chronologie_fma" model="ir.ui.view">
        <field name="name">sale.order.form.chronologie.fma</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='fma_chronologie_page']/group/group[1]" position="inside">
                <field name="x_studio_date_de_relance_1"/>
                <field name="x_studio_date_de_relance_2"/>
            </xpath>

            <xpath expr="//page[@name='fma_chronologie_page']/group/group[2]" position="inside">
                <field name="x_studio_commentaire_supplmentaire"/>
            </xpath>

        </field>
    </record>


    <!--
        §1/§2 du handoff : la barre d'etat ne garde que les actions du
        quotidien. Pro forma et Annuler passent dans le menu Action via des
        actions serveur liees au modele (binding), comme le veut le standard
        Odoo. Import Pricer fait de meme, mais depuis son propre module.
    -->
    <record id="view_order_form_actions_fma" model="ir.ui.view">
        <field name="name">sale.order.form.actions.fma</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="action_server_proforma" model="ir.actions.server">
        <field name="name">Envoyer la facture pro forma</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.with_context(proforma=True, validate_analytic=True).action_quotation_send()</field>
    </record>

    <record id="action_server_cancel" model="ir.actions.server">
        <field name="name">Annuler le devis</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_cancel()</field>
    </record>


    <!--
        Note : on ne peut PAS remplacer x_studio_commercial_1 par heritage.
        Studio le pose via sa propre vue, et cette vue est ecartee pendant la
        mise a jour des modules parce qu'elle reference des champs « manual »
        absents du registre a ce moment-la. Aucune priorite ne contourne ca :
        l'element n'existe tout simplement pas quand nos vues sont validees.
        Le retrait de l'ancien champ se fait donc dans Studio.
    -->


    <!--
        §4 du handoff : les quatre paves de la maquette.

        Ces groupes ne contiennent que des champs declares en code — c'est la
        condition pour qu'une vue de module puisse les poser. Les memes champs
        etant aujourd'hui places par Studio dans la colonne client, il faut
        les y retirer cote Studio, sinon ils apparaitront deux fois.

        payment_term_id n'y figure pas volontairement : il est pose par la vue
        standard puis deplace par Studio. Le reprendre ici entrerait en
        conflit avec l'un ou l'autre.
    -->
    <record id="view_order_form_paves_fma" model="ir.ui.view">
        <field name="name">sale.order.form.paves.fma</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Le bloc natif n'a pas de titre : sans lui, « Client » serait le
                 seul pave des quatre a ne pas etre annonce. -->
            <xpath expr="//group[@name='partner_details']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>

            <!-- Client : on complete le bloc natif plutot que de le refaire. -->
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="main_contact_id"
                       string="Contact principal"
                       domain="[('parent_id', '=', partner_id)]"
                       context="{'default_parent_id': partner_id}"/>
                <field name="so_commande_client"/>
            </xpath>

            <!-- « Affaire & equipe » prend la colonne de droite, en face du
                 bloc Client : c'est la disposition en deux colonnes de la
                 maquette. On l'insere comme frere de partner_details, dont
                 l'existence est deja prouvee par l'xpath ci-dessus, plutot
                 que dans le groupe de droite natif dont le nom varie d'une
                 version a l'autre. -->
            <xpath expr="//group[@name='partner_details']" position="after">
                <group string="Affaire &amp; équipe" name="fma_affaire">
                    <!-- Le projet natif, pas le champ Studio : c'est lui que
                         lisent mrp_capacity_planning et fma_mrp_dashboard, et
                         lui qui porte le compte analytique du chantier. -->
                    <field name="project_id" string="Projet"/>
                    <!-- Le chantier se cree depuis le devis, comme aujourd'hui :
                         son numero est celui du devis, il ne reste qu'a taper
                         le libelle. Pour une deuxieme tranche, on choisit le
                         chantier existant dans le champ ci-dessus. -->
                    <button name="action_creer_chantier" type="object"
                            string="Créer le chantier"
                            class="btn-link ps-0"
                            invisible="project_id or not partner_id"/>
                    <!-- La reference telle que les metiers la lisent, avec son
                         suffixe de tranche quand le chantier en compte
                         plusieurs. Calculee, jamais saisie. -->
                    <field name="x_ref_tranche" readonly="1"
                           invisible="not x_ref_tranche"/>
                    <field name="x_studio_numro_iziqo"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="commercial_id"/>
                    <field name="x_studio_commercial_si_prospect"/>
                    <field name="x_studio_bureau_dtude"/>
                    <!-- Gamme et serie : la serie est filtree par la gamme
                         choisie (x_serie_mtn.x_studio_gamme_de_la_srie), et
                         les deux modeles ont « x_name » pour libelle, d'ou
                         create_name_field — sans quoi la creation a la volee
                         depuis le devis echouerait. C'est ce que faisait la
                         vue Studio ; on le reprend. -->
                    <field name="x_studio_gamme"
                           options="{'create_name_field': 'x_name'}"/>
                    <field name="x_studio_srie"
                           options="{'create_name_field': 'x_name'}"
                           domain="[('x_studio_gamme_de_la_srie', '=', x_studio_gamme)]"/>
                </group>
            </xpath>

            <!-- Deuxieme rangee de la maquette : Conditions a gauche, Statut
                 de l'affaire a droite. -->
            <xpath expr="//group[@name='sale_header']" position="after">
                <group name="fma_paves">

                    <group string="Conditions" name="fma_conditions">
                        <field name="x_studio_mode_de_rglement"/>
                        <field name="so_delai_confirme_en_semaine"/>
                        <field name="so_date_de_livraison" readonly="1"/>
                    </group>

                    <group string="Statut de l'affaire" name="fma_statut">
                        <field name="x_studio_motif_annul"/>
                        <field name="x_studio_avancement"/>
                        <field name="x_studio_date_de_relance_1"/>
                        <field name="x_studio_date_de_relance_2"/>
                        <field name="x_studio_commentaire_supplmentaire"/>
                    </group>

                </group>
            </xpath>

        </field>
    </record>

</odoo>
