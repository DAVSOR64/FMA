<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Création Facture Fournisseur en masse" (action_create_supplier_invoices,
         stock_picking_actions.xml) n'était accessible que via le menu Actions.
         Retour métier T-30 (capture V17 vs V19) : la version Studio d'origine
         avait un vrai bouton "Facture Brouillon" dans l'en-tête de la fiche
         réception, absent côté V19, à tort. -->
    <record id="view_picking_form_supplier_invoice_button" model="ir.ui.view">
        <field name="name">stock.picking.form.supplier.invoice.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_supplier_invoices"
                        type="object"
                        string="Facture Brouillon"/>
            </xpath>
        </field>
    </record>
</odoo>
