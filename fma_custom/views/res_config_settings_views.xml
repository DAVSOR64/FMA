<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ancre sur l'app « purchase » et non sur un bloc interne : les noms
         de blocs d'Odoo changent d'une version a l'autre, l'app non. -->
    <record id="view_res_config_settings_form_fma_achat" model="ir.ui.view">
        <field name="name">res.config.settings.form.fma.achat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="FMA" name="fma_achat_container">
                    <setting id="fma_acheteur_defaut_setting"
                             string="Acheteur par défaut"
                             help="Responsable porté sur tout bon d'achat qui n'en a pas, y compris ceux nés de l'approvisionnement. Sans lui, ces bons n'apparaissent dans la liste « Mes commandes » de personne.">
                        <field name="fma_acheteur_defaut_id"
                               options="{'no_create': True}"/>
                    </setting>
                    <!-- Un acheteur par atelier : les deux vivent dans la
                         meme societe, le defaut ci-dessus ne les departage
                         pas. C'est l'etiquette de l'affaire qui tranche. -->
                    <setting id="fma_acheteur_par_etiquette_setting"
                             string="Acheteur par atelier"
                             help="Responsable porté sur les bons d'achat nés de l'approvisionnement, selon l'étiquette de l'affaire. Vide : l'acheteur par défaut s'applique.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="fma_acheteur_fma_id" string="Affaires FMA"
                                       class="col-lg-4 o_light_label"/>
                                <field name="fma_acheteur_fma_id"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="fma_acheteur_f2m_id" string="Affaires F2M"
                                       class="col-lg-4 o_light_label"/>
                                <field name="fma_acheteur_f2m_id"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
