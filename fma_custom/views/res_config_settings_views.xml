<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ancre sur l'app « purchase » et non sur un bloc interne : les noms
         de blocs d'Odoo changent d'une version a l'autre, l'app non. -->
    <record id="view_res_config_settings_form_fma_achat" model="ir.ui.view">
        <field name="name">res.config.settings.form.fma.achat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="FMA" name="fma_achat_container">
                    <setting id="fma_acheteur_defaut_setting"
                             string="Acheteur par défaut"
                             help="Responsable porté sur tout bon d'achat qui n'en a pas, y compris ceux nés de l'approvisionnement. Sans lui, ces bons n'apparaissent dans la liste « Mes commandes » de personne.">
                        <field name="fma_acheteur_defaut_id"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
