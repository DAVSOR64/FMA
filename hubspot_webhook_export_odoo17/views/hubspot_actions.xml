<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Envoi complet de reprise, a lancer une seule fois. Le quotidien passe
        ensuite par le cron « Clients crees ou modifies dans la journee ».
    -->
    <record id="action_hubspot_export_complet" model="ir.actions.server">
        <field name="name">HubSpot - Envoi complet des entreprises (par lots de 500)</field>
        <field name="model_id" ref="model_hubspot_webhook_export"/>
        <field name="state">code</field>
        <field name="code">model.action_export_entreprises_complet_par_lots()</field>
    </record>
</odoo>
