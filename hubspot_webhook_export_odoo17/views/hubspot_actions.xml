<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Actions de reprise, a lancer une seule fois. Le quotidien passe ensuite
        par les crons « ... dans la journee ».

        Le formulaire d'une action serveur n'offre pas de bouton d'execution :
        pour les declencher, utiliser les actions planifiees homonymes
        (prefixees REPRISE) et leur bouton « Executer manuellement ».
    -->
    <record id="action_hubspot_export_complet" model="ir.actions.server">
        <field name="name">HubSpot - Envoi complet des entreprises (par lots de 500)</field>
        <field name="model_id" ref="model_hubspot_webhook_export"/>
        <field name="state">code</field>
        <field name="code">model.action_export_entreprises_complet_par_lots()</field>
    </record>

    <record id="action_hubspot_export_devis_complet" model="ir.actions.server">
        <field name="name">HubSpot - Envoi complet des devis/commandes (par lots de 500)</field>
        <field name="model_id" ref="model_hubspot_webhook_export"/>
        <field name="state">code</field>
        <field name="code">model.action_export_devis_complet_par_lots()</field>
    </record>

    <record id="action_hubspot_export_tout_complet" model="ir.actions.server">
        <field name="name">HubSpot - Envoi complet entreprises + devis (par lots de 500)</field>
        <field name="model_id" ref="model_hubspot_webhook_export"/>
        <field name="state">code</field>
        <field name="code">model.action_export_complet_par_lots()</field>
    </record>
</odoo>
