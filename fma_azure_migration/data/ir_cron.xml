<?xml version="1.0" encoding="utf-8"?>
<!--
    noupdate : l'activation est un GESTE D'EXPLOITATION, pas une donnee du
    module. Sans cela, un build qui met le module a jour remettrait l'action
    a « inactive » au milieu de la migration.
-->
<odoo noupdate="1">

    <!--
        LIVREE INACTIVE. On l'active a la main quand on veut que la migration
        commence, et elle se desactive elle-meme quand il ne reste plus rien
        dans le perimetre.

        Cinq minutes : le passage s'arrete de lui-meme au bout de quatre
        (parametre fma_azure.secondes), il n'y a donc jamais deux passages
        qui se chevauchent.

        Le modele est ir.attachment, et le code appelle UNE methode : tout le
        travail, les bornes et le journal vivent en Python, ou on peut les
        lire et les corriger.
    -->
    <record id="ir_cron_fma_azure" model="ir.cron">
        <field name="name">FMA - MIGRATION : pièces jointes vers Azure</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model.fma_migrer_vers_azure()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="nextcall"
               eval="(datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
